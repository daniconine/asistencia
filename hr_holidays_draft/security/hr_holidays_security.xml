<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hr_holidays_draft_leave_rule_employee_manager" model="ir.rule">
            <field name="name">Draft time Off base.erp_group_manager manager</field>
            <field name="model_id" ref="model_hr_holidays_draft_leave"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('base.group_erp_manager'))]"/>
        </record>

        <record id="hr_holidays_draft_leave_rule_employee" model="ir.rule">
            <field name="name">Draft time Off base.group_user read</field>
            <field name="model_id" ref="model_hr_holidays_draft_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
