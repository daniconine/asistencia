<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="NightModeTemplate">
		<div class="o_night_mode">
				
				<t t-if="widget.day_mode">
					<span class="fa fa-moon-o" id="moon_button" style="font-size: 16px;vertical-align: middle;display:inline-flex;"></span>
					<span class="fa fa-sun-o" id="sun_button" style="display:none;font-size: 16px;vertical-align: middle;"></span>
				</t>
				<t t-else="">
					<span class="fa fa-moon-o" id="moon_button" style="font-size: 16px;vertical-align: middle;display:none;"></span>
					<span class="fa fa-sun-o" id="sun_button" style="display:inline-flex;font-size: 16px;vertical-align: middle;"></span>
				</t>


			 <input type="checkbox" id="night_checkbox" style="display:none;"/>
        </div>
	</t>
</templates>
