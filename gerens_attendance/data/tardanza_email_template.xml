<?xml version="1.0" encoding="utf-8"?>
    <odoo>
        <data noupdate="1">
            <record id="tardanza_email_template" model="mail.template">
                <field name="name">Correo_Tardanza</field>
                <field name="email_from">${object.company_id.email | safe}</field>
                <field name="email_to">${object.employee_id.work_email | safe}</field>
                <field name="email_cc">${object.company_id.hr_manager_id.work_email | safe}</field>
                <field name="subject">Tardanza detectada: ${object.employee_id.name}</field>
                <field name="model_id" ref="hr.model_hr_attendance"/>
                <field name="body_html" type="html">
                    <p>Estimado/a ${object.employee_id.name},</p>
                    <p>Se ha detectado una tardanza de <strong>${object.tardanza_minutos}</strong> minutos.</p>
                    <p>Saludos cordiales,</p>
                    <p>El equipo de Recursos Humanos</p>
                </field>
            </record>
        </data>
    </odoo>
