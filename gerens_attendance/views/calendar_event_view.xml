<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_form_employee" model="ir.ui.view">
        <field name="name">calendar.event.form.employee</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='user_id']]" position="inside">
                <field name="employee_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_calendar_event_tree_employee" model="ir.ui.view">
        <field name="name">calendar.event.tree.employee</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_id"/>
            </xpath>
        </field>
    </record>
</odoo>
