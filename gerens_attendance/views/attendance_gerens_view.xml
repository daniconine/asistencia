<odoo>
    <record id="view_hr_attendance_tree_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="horas_faltantes" />
                <field name="weekday"/>
                <field name="entry_time"/>
                <field name="exit_time"/>
                <field name="tardanza_minutos"/>
            </xpath>
            <!-- Decorations -->
            <xpath expr="//field[@name='horas_faltantes']" position="attributes">
                <attribute name="decoration-danger">horas_faltantes &lt; 0</attribute>
                <attribute name="decoration-success">horas_faltantes &gt; 0</attribute>
            </xpath>
        </field>
    </record>
            
</odoo>
